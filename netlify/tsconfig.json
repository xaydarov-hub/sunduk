{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.mts",
    "../src/lib/loyalty/shared.ts",
    "../scripts/**/*.ts"
  ]
}
