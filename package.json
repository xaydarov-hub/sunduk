    "lucide-react": "^0.414.0",
    "next": "14.2.5",
    "postcss": "^8.4.40",
    "qrcode-generator": "^1.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.4.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
