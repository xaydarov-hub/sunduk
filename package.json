{
  "name": "sunduk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p netlify/tsconfig.json",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-sunduk",
    "deploy:rules": "firebase deploy --only firestore",
    "deploy": "npm run build && netlify deploy --prod --dir=out",
    "deploy:vercel": "vercel deploy --prod",
    "test:bot": "tsx scripts/bot-test.ts",
    "dev:functions": "tsx scripts/dev-functions.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.1",
